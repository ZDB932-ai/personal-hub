{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "notification:default",
    "opener:default",
    "dialog:allow-save",
    "dialog:allow-message",
    "fs:allow-write-file"
  ]
}
