{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "todo-host",
  "description": "Main window owns the encrypted Todo session",
  "windows": ["main"],
  "permissions": [
    "allow-todo-connect", "allow-todo-publish", "allow-todo-read", "allow-todo-configure",
    "allow-todo-reset-position", "allow-todo-work", "allow-todo-resolve", "allow-todo-home",
    "allow-todo-heartbeat", "allow-todo-disconnect", "allow-todo-finish-quit", "allow-todo-cancel-quit",
    "allow-pet-preferences", "allow-pet-configure", "allow-pet-home", "allow-pet-reset-position"
  ]
}
