{
  "name": "personal-hub",
  "private": true,
  "version": "1.1.4",
  "androidVersionCode": 6,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/versions.mjs && vue-tsc --noEmit && vite build",
    "version:sync": "node scripts/versions.mjs --write",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "sync:server": "node server/start.ts",
    "sync:typecheck": "tsc -p server/tsconfig.json",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "test:ui": "node scripts/verify-hub-ui.mjs && node scripts/verify-today-simple.mjs && node scripts/verify-release-ui.mjs && node scripts/verify-local-account.mjs && node scripts/verify-ui-redesign.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
